{
  "name": "lionclub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "app-store:check": "node scripts/check-app-store-readiness.mjs",
    "native:check": "node scripts/check-native-environment.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "cleanup:account-deletion": "node scripts/discover-account-deletion-jobs.mjs",
    "cleanup:rate-limit": "node scripts/cleanup-rate-limit-attempts.mjs",
    "test:onboarding": "node --import tsx --test tests/*.test.ts",
    "test:simulation": "node --test tests/*.test.mjs",
    "simulation:preview": "node scripts/simulation-preview.mjs",
    "test:all": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs scripts/demo-*.test.mjs",
    "demo:preview": "node scripts/demo-preview.mjs",
    "test:demo": "node --test scripts/demo-*.test.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/credential-provider-node": "^3.972.85",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^6.19.3",
    "@smithy/signature-v4": "^5.7.4",
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "prisma": "^6.19.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
