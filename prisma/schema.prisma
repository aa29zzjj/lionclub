// lionclub 會員端資料庫 schema
// 對照 docs/MEMBER_EXPERIENCE_HANDOFF.md 的資歷資料契約，
// 以及組織架構採單表 + level 欄位（非巢狀四表），對齊前端 club-directory.ts / experience-data.ts 的資料形狀。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────
// 組織架構：單一表 + level 區分複合區／專區／分區／分會／基金會等
// ────────────────────────────────

enum OrganizationLevel {
  international
  md
  district
  region
  zone
  club
  foundation
}

model Organization {
  id           String            @id @default(cuid())
  level        OrganizationLevel
  code         String?
  name         String
  parentId     String?
  parent       Organization?     @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Organization[]    @relation("OrgHierarchy")
  districtCode String?

  isActive  Boolean   @default(true)
  validFrom DateTime?
  validTo   DateTime?

  sourceLabel String?
  sourceUrl   String?
  verifiedAt  DateTime?

  members            Member[]
  hostedEvents        Event[]
  clubInvites         ClubInvite[]
  memberExperiences   MemberExperience[]
  annualAppointments  AnnualAppointment[]
  resourceNeeds       ResourceNeed[]
  serviceEntries      ServiceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([districtCode])
}

// ────────────────────────────────
// 會員與帳號
// role:   MEMBER | CLUB_OFFICER | CLUB_PRESIDENT | FINANCE | DISTRICT_ADMIN | SUPER_ADMIN（顯示用，非權限判斷依據）
// status: PENDING | ACTIVE | SUSPENDED
// ────────────────────────────────

model Member {
  id       String    @id @default(cuid())
  name     String
  nickname String?
  birthday DateTime?
  photoUrl String?
  title    String? // 職缺／職稱（顯示用文字，不等於系統權限）
  bio      String?
  email    String?   @unique
  phone    String?
  memberNo  String?
  joinYear  Int?
  joinMonth Int?
  validUntil DateTime?

  lineUserId String? @unique

  role   String @default("MEMBER")
  status String @default("PENDING")
  deletedAt DateTime? // 已移除帳號與個資；匿名節點保留共享活動／稽核，不可再登入

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // ACTIVE 僅表示可以使用平台；正式分會歸屬核對獨立追蹤。
  // 既有會員保持 ASSIGNED，只有中央新註冊寫入 NEEDS_ASSIGNMENT。
  organizationAssignmentStatus  String @default("ASSIGNED")
  organizationAssignmentVersion Int    @default(0)
  declaredOrganizationName      String? // 本人自填，尚未核對，不作為授權依據
  organizationAssignments       MemberOrganizationAssignment[] @relation("OrganizationAssignmentMember")
  assignmentsMade               MemberOrganizationAssignment[] @relation("OrganizationAssignmentActor")

  tags Tag[] @relation("MemberTags")

  user User?
  dataConsents MemberDataConsent[]
  emailVerifiedAt DateTime?

  // 註冊當下對隱私政策的同意紀錄；versioned so a later policy change can be re-prompted.
  privacyConsentedAt     DateTime?
  privacyConsentVersion  String?

  // 使用條款（含不容忍違規內容、檢舉與停權規則）的同意紀錄。
  termsAcceptedAt DateTime?
  termsVersion    String?

  experiences         MemberExperience[]       @relation("MemberExperiences")
  verifiedExperiences MemberExperience[]       @relation("ExperienceVerifiedBy")
  experienceReviewsMade ExperienceReviewAudit[] @relation("ExperienceReviewActor")

  friendRequestsSent     Friendship[] @relation("FriendshipRequester")
  friendRequestsReceived Friendship[] @relation("FriendshipAddressee")

  eventRegistrations EventRegistration[]
  checkedInRegistrations EventRegistration[] @relation("EventCheckedInBy")
  checkInHistory EventCheckInAudit[] @relation("CheckInMember")
  checkInsPerformed EventCheckInAudit[] @relation("CheckInActor")
  accountDeletionCleanup AccountDeletionCleanup?
  createdEvents       Event[]              @relation("EventCreatedBy")

  sentNotifications      EventNotification[]          @relation("NotificationSender")
  receivedNotifications  EventNotificationRecipient[]
  mobilePushDevices MobilePushDevice[]
  mobilePushReceipts MobilePushReceipt[] @relation("PushReceiptRecipient")
  mobilePushReceiptsAuthored MobilePushReceipt[] @relation("PushReceiptActor")
  emailActionChallenges EmailActionChallenge[]

  issuedInvites ClubInvite[] @relation("InviteIssuedBy")

  adminRoles      AdminRole[] @relation("AdminRoleMember")
  grantedRoles    AdminRole[] @relation("AdminRoleGrantedBy")

  blocksMade      MemberBlock[]  @relation("BlockerMember")
  blockedBy       MemberBlock[]  @relation("BlockedMember")
  reportsMade     MemberReport[] @relation("ReporterMember")
  reportsReceived MemberReport[] @relation("ReportedMember")
  reportsReviewed MemberReport[] @relation("ReportReviewedBy")
  eventReportsMade     EventReport[] @relation("EventReporter")
  eventReportsReviewed EventReport[] @relation("EventReportReviewedBy")
  resourceNeeds ResourceNeed[]
  resourceResponses ResourceResponse[]
  serviceEntries ServiceEntry[] @relation("ServiceEntryMember")
  serviceEntriesReviewed ServiceEntry[] @relation("ServiceEntryReviewer")
  serviceOutcomesEdited EventOutcome[]
  serviceAudits ServiceAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationAssignmentStatus, organizationId])
}

// 每次確認／改派同交易寫入；保留組織名稱快照，不改寫資歷或活動歷史。
model MemberOrganizationAssignment {
  id                     String @id @default(cuid())
  memberId               String
  member                 Member @relation("OrganizationAssignmentMember", fields: [memberId], references: [id], onDelete: Cascade)
  fromOrganizationId     String?
  fromOrganizationName   String?
  toOrganizationId       String
  toOrganizationName     String
  previousAssignmentStatus String
  assignmentStatus       String
  assignedById           String?
  assignedBy             Member? @relation("OrganizationAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)
  reason                 String
  revokedRoleNames       String[] @default([])
  revokedInviteCount     Int @default(0)
  assignedAt             DateTime @default(now())

  @@index([memberId, assignedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // null only for explicitly registered federated-only accounts
  sessionVersion Int @default(1)
  memberId     String?  @unique
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  federatedIdentities FederatedIdentity[]
  oauthTransactions OAuthTransaction[]
  mobilePushDevices MobilePushDevice[]
  mobilePushReceipts MobilePushReceipt[]
  emailActionChallenges EmailActionChallenge[]
}

model MemberDataConsent {
  id String @id @default(cuid())
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  purpose String
  version String
  acceptedAt DateTime @default(now())

  @@unique([memberId, purpose, version])
}

// Provider + stable subject is the identity. Email is never an automatic link key.
model FederatedIdentity {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  subject String
  email String
  securityEmailVerifiedAt DateTime? // Set only after a newly verified Apple authorization; legacy rows are not backfilled.
  refreshTokenCiphertext String? // Apple revocation token, AES-256-GCM encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailActionChallenges EmailActionChallenge[]

  @@unique([provider, subject])
  @@unique([userId, provider])
}

// Separate from provider authentication: a code sent to an immutable,
// provider-attested contact authorizes one explicit sensitive action only.
model EmailActionChallenge {
  id String @id @db.Uuid
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionVersion Int
  identityId String
  identity FederatedIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityUpdatedAt DateTime
  identityVerifiedAt DateTime
  email String
  action String
  codeHash String? @db.Char(64)
  deliveryState String @default("PENDING")
  attempts Int @default(0)
  expiresAt DateTime
  verifiedAt DateTime?
  invalidatedAt DateTime?
  proofHash String? @unique @db.Char(64)
  proofExpiresAt DateTime?
  proofUsedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
  @@index([expiresAt])
}

// Short-lived, browser-bound, one-use authorization/registration/reauth state.
// No provider tokens, authorization codes or verifier are exposed to client JS.
model OAuthTransaction {
  id String @id @default(cuid())
  provider String
  purpose String
  stateHash String @unique
  browserHash String
  nonce String
  codeVerifier String?
  inviteToken String? // invitation stays server-side; never forwarded to provider
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int?
  expiresAt DateTime
  claimedAt DateTime?
  verifiedAt DateTime?
  completedAt DateTime?
  subject String?
  email String?
  providerName String?
  refreshTokenCiphertext String?
  reauthHash String? @unique
  reauthExpiresAt DateTime?
  reauthUsedAt DateTime?
  reauthAction String? // which sensitive action ("link" | "sessions" | "delete") this proof may authorize; consumeOAuthReauth must match it exactly
  emailActionChallengeId String? @db.Uuid // Consumed email step-up for web linking; missing/expired source must fail closed.
  nativeRedirectUri String? // set only for native-app flows; web flows stay null and keep today's cookie-session completion
  nativeState String? // app-generated state; independent of the provider's state/nonce
  nativeCodeChallenge String? // app S256 challenge, never its verifier
  nativeBootstrapUsedAt DateTime?
  nativeHandoffHash String? @unique // opaque one-use handoff; no user data in its URL
  nativeHandoffExpiresAt DateTime?
  nativeHandoffUsedAt DateTime?
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, reauthExpiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String @default("") // 空字串僅供舊版 writer 切換；新版消費端必須拒絕
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  email     String @default("") // 空字串僅供舊版 writer 切換；新版消費端必須拒絕
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// 時窗亦在 key 中，由資料庫 upsert 原子遞增，不以 read/reset 覆蓋併發計數。
model RateLimitAttempt {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

// 刪帳後可重試本人 avatar 清理，永不刪 events/ 共享資產。
model AccountDeletionCleanup {
  id           String @id @default(cuid())
  memberId     String @unique
  member       Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  avatarPrefix String
  bucket       String?
  region       String?
  status       String @default("PENDING")
  attemptCount Int @default(0)
  processingStartedAt DateTime?
  lastError    String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model MemberBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   Member   @relation("BlockerMember", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   Member   @relation("BlockedMember", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model MemberReport {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     Member    @relation("ReporterMember", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId     String
  target       Member    @relation("ReportedMember", fields: [targetId], references: [id], onDelete: Cascade)
  reason       String
  details      String?
  status       String    @default("PENDING") // PENDING | REVIEWED | DISMISSED
  reviewedById String?
  reviewedBy   Member?   @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([targetId])
}

// ────────────────────────────────
// 會員／幹部資歷（對照 docs/MEMBER_EXPERIENCE_HANDOFF.md）
// ────────────────────────────────

enum ExperienceKind {
  membership
  position
  honorary
  advisor
  other
}

enum DatePrecision {
  month
  lions_year
  approximate
}

enum VerificationStatus {
  self_declared
  under_review
  verified
  rejected
}

enum ExperienceVisibility {
  public
  members
  only_me
}

model Position {
  code  String         @id
  name  String
  level OrganizationLevel
  kind  ExperienceKind
}

model MemberExperience {
  id     String @id @default(cuid())
  memberId String
  member   Member @relation("MemberExperiences", fields: [memberId], references: [id], onDelete: Cascade)

  kind         ExperienceKind
  level        OrganizationLevel
  positionCode String

  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationName       String // 顯示用；官方名單找不到時手動輸入
  organizationIsUnlisted Boolean @default(false)
  multipleDistrictCode   String?
  districtCode           String?

  startYear Int
  startMonth Int? // membership calendar month; null means unknown, never infer July
  endYear   Int?
  datePrecision DatePrecision
  isCurrent     Boolean

  verificationStatus VerificationStatus @default(self_declared)
  visibility         ExperienceVisibility @default(members)
  note               String?

  verifiedById String?
  verifiedBy   Member?   @relation("ExperienceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  rejectedReason String?
  auditReviews ExperienceReviewAudit[]

  // 來自年度核定名冊的比對建議；避免同一筆名冊任職被重複帶入。刪除名冊來源不影響既有資歷。
  sourceAppointmentId String?            @unique
  sourceAppointment   AnnualAppointment? @relation(fields: [sourceAppointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([organizationId])
}

// 核實資歷的稽核紀錄，不代表 AdminRole。刪帳後 actor 斷鏈，不保留姓名快照。
model ExperienceReviewAudit {
  id String @id @default(cuid())
  experienceId String?
  experience MemberExperience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  actorId String?
  actor Member? @relation("ExperienceReviewActor", fields: [actorId], references: [id], onDelete: SetNull)
  action String
  reviewRole String
  scopeId String?
  reason String?
  experienceUpdatedAt DateTime
  createdAt DateTime @default(now())

  @@index([experienceId, createdAt])
  @@index([actorId, createdAt])
}

// 年度名冊與登入會員／自填資歷分離。沒有 Email／MemberID 也能保存核定任職。
// 本表不建立 Member、User、MemberExperience 或 AdminRole，也不以姓名自動連結。
model RosterImportBatch {
  id String @id
  sourceDigest String @unique
  yearStart Int
  approvedBy String
  approvedAt DateTime
  appliedAt DateTime @default(now())
  organizationCount Int
  appointmentCount Int
  appointments AnnualAppointment[]
}

model AnnualAppointment {
  id String @id
  batchId String
  batch RosterImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceKey String
  yearStart Int
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  positionName String
  personName String
  homeClubSourceName String?
  listingNature String
  sourcePage String
  approvedBy String
  approvedAt DateTime
  createdAt DateTime @default(now())

  claimedByExperience MemberExperience?

  @@unique([batchId, sourceKey])
  @@unique([yearStart, organizationId, sourceKey])
  @@index([organizationId, yearStart])
}

// ────────────────────────────────
// 好友系統
// status: PENDING | ACCEPTED | BLOCKED
// source: SEARCH | QR_SCAN
// ────────────────────────────────

model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   Member @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   Member @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status String @default("PENDING")
  source String @default("SEARCH")

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}

// ────────────────────────────────
// 標籤（專長／資源／興趣）
// category: PROFESSIONAL | RESOURCE | INTEREST
// ────────────────────────────────

model Tag {
  id       String   @id @default(cuid())
  name     String   @unique
  category String   @default("PROFESSIONAL")
  members  Member[] @relation("MemberTags")
}

// ────────────────────────────────
// 活動發布 ＋ 通知
// scope: CLUB | ZONE | REGION | DISTRICT — 發佈層級，CLUB_OFFICIAL 類活動發佈到分會以上範圍時須有對應管理角色
// ────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  capacity    Int?
  scope       String   @default("CLUB")
  category    String   @default("CLUB_OFFICIAL")
  // Rolling deployment: accessed via capability-gated event-tags.ts until all DBs migrate.
  tags        String[] @default([]) @ignore
  coverPhotoUrl String?

  hostOrganizationId String
  hostOrganization   Organization @relation(fields: [hostOrganizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   Member @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  registrations EventRegistration[]
  checkInHistory EventCheckInAudit[]
  notifications EventNotification[]
  reports       EventReport[]
  serviceOutcome EventOutcome?
  serviceEntries ServiceEntry[]

  createdAt DateTime @default(now())
}

// 活動內容檢舉。活動被移除內容後仍保留標題快照，處置紀錄不隨活動消失。
model EventReport {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     Member    @relation("EventReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  eventId      String?
  event        Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventTitle   String
  reason       String
  details      String?
  status       String    @default("PENDING") // PENDING | REVIEWED | DISMISSED | CONTENT_REMOVED
  reviewedById String?
  reviewedBy   Member?   @relation("EventReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([eventId])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())
  checkedInAt  DateTime?
  checkedInById String?
  checkedInBy   Member?  @relation("EventCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkInAudit EventCheckInAudit?

  @@unique([eventId, memberId])
  @@index([eventId, status])
}

model EventCheckInAudit {
  id             String @id @default(cuid())
  eventId        String
  event          Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String @unique
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  memberId       String
  member         Member @relation("CheckInMember", fields: [memberId], references: [id], onDelete: Restrict)
  actorId        String
  actor          Member @relation("CheckInActor", fields: [actorId], references: [id], onDelete: Restrict)
  method         String
  reason         String?
  checkedInAt    DateTime @default(now())

  @@index([eventId, checkedInAt])
}

model EventNotification {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId String
  sender   Member   @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Restrict)
  message  String
  sentAt   DateTime @default(now())

  recipients EventNotificationRecipient[]
}

model EventNotificationRecipient {
  id             String             @id @default(cuid())
  notificationId String
  notification   EventNotification  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      Member             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  readAt         DateTime?

  @@unique([notificationId, recipientId])
}

// Optional native push foundation. No existing route queries these tables while
// MOBILE_PUSH_ENABLED is off. The migration must be explicitly deployed first.
model MobilePushDevice {
  id String @id @default(cuid())
  installationId String @unique @db.Uuid
  revision BigInt
  bindingVersion Int @default(1)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionVersion Int
  environment String
  topic String
  tokenHash String? @db.Char(64)
  tokenCiphertext String?
  enabled Boolean @default(true)
  lastSeenAt DateTime @default(now())
  leaseExpiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries MobilePushDelivery[]

  @@unique([environment, topic, tokenHash])
  @@index([memberId, enabled, leaseExpiresAt])
  @@index([userId, enabled, leaseExpiresAt])
}

// Generic receipt only; never copies names, message bodies or review reasons.
// Polymorphic source identifiers are re-authorized against their real source
// before every feed response and delivery, not trusted as permission by themselves.
model MobilePushReceipt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId String
  member Member @relation("PushReceiptRecipient", fields: [memberId], references: [id], onDelete: Cascade)
  actorId String
  actor Member @relation("PushReceiptActor", fields: [actorId], references: [id], onDelete: Cascade)
  kind String
  sourceId String
  sourceRevision String @default("")
  createdAt DateTime @default(now())
  expiresAt DateTime
  readAt DateTime?
  deliveries MobilePushDelivery[]

  @@unique([userId, kind, sourceId, sourceRevision])
  @@index([memberId, createdAt])
  @@index([expiresAt])
}

// Durable per-device transactional outbox. ACCEPTED means APNs accepted it,
// never proof of display/delivery. A claimed job is bounded and single-worker.
model MobilePushDelivery {
  id String @id @default(cuid())
  apnsId String @unique @default(uuid()) @db.Uuid
  receiptId String
  receipt MobilePushReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  deviceId String
  device MobilePushDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  bindingVersion Int
  sessionVersion Int
  status String @default("PENDING")
  attemptCount Int @default(0)
  availableAt DateTime @default(now())
  expiresAt DateTime
  lockId String? @db.Uuid
  lockedAt DateTime?
  acceptedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([receiptId, deviceId, bindingVersion])
  @@index([status, availableAt])
  @@index([expiresAt])
}

// ────────────────────────────────
// QR + PIN 入會邀請
// ────────────────────────────────

model ClubInvite {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pin          String // 給人看著畫面手動輸入
  token        String   @unique // 長隨機字串，只放在 QR 碼編碼的網址裡，掃描後免輸入 PIN
  issuedById   String
  issuedBy     Member   @relation("InviteIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)

  validFrom  DateTime @default(now())
  validUntil DateTime
  revokedAt  DateTime? // 幹部手動停用

  usageCount Int @default(0)
  usageLimit Int?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ────────────────────────────────
// 管理權限（與職稱／資歷完全分開）
// role:      CLUB_OFFICER | CLUB_PRESIDENT | CLUB_FINANCE | ZONE_ADMIN | REGION_ADMIN | DISTRICT_ADMIN | MULTIDISTRICT_ADMIN | SUPER_ADMIN
//            | DISTRICT_GOVERNOR | DISTRICT_SECRETARY | DISTRICT_CABINET（總監／秘書長／區內閣，僅能查核會員資歷，無分會管理權）
// scopeType: 同 OrganizationLevel，SUPER_ADMIN 用 GLOBAL（scopeId 為 null）
// ────────────────────────────────

model AdminRole {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation("AdminRoleMember", fields: [memberId], references: [id], onDelete: Cascade)

  role      String
  scopeType String
  scopeId   String?

  grantedById String?
  grantedBy   Member? @relation("AdminRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  validFrom  DateTime  @default(now())
  validUntil DateTime?

  @@index([memberId])
  @@index([scopeType, scopeId])
}

// Service hub: group outcomes never create individual confirmed hours.
model EventOutcome {
  eventId String @id
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endAt DateTime
  beneficiaryCount Int?
  quantity Int @default(0)
  quantityUnit String
  totalServiceMinutes Int @default(0)
  summary String
  editedById String
  editedBy Member @relation(fields: [editedById], references: [id], onDelete: Restrict)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResourceNeed {
  id String @id @default(cuid())
  ownerId String
  owner Member @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestId String
  kind String @default("NEED")
  title String
  category String
  description String
  targetDate DateTime @db.Date
  quantity Int
  quantityUnit String
  status String @default("OPEN")
  version Int @default(1)
  acceptedResponseId String? @unique
  acceptedResponse ResourceResponse? @relation("AcceptedResourceResponse", fields: [acceptedResponseId], references: [id], onDelete: Restrict)
  responses ResourceResponse[] @relation("ResourceResponses")
  completionNote String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ownerId, requestId])
  @@index([status, createdAt, id])
  @@index([organizationId])
}

model ResourceResponse {
  id String @id @default(cuid())
  needId String
  need ResourceNeed @relation("ResourceResponses", fields: [needId], references: [id], onDelete: Restrict)
  memberId String
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  message String
  status String @default("PENDING")
  acceptedByNeed ResourceNeed? @relation("AcceptedResourceResponse")
  createdAt DateTime @default(now())
  @@unique([needId, memberId])
}

model ServiceEntry {
  id String @id @default(cuid())
  memberId String
  member Member @relation("ServiceEntryMember", fields: [memberId], references: [id], onDelete: Restrict)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId String?
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requestId String
  dedupKey String
  title String
  date DateTime @db.Date
  category String
  minutes Int
  note String?
  status String @default("PENDING")
  version Int @default(1)
  reviewedById String?
  reviewedBy Member? @relation("ServiceEntryReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt DateTime?
  reviewReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([memberId, requestId])
  @@unique([memberId, dedupKey])
  @@index([memberId, date, id])
  @@index([organizationId, status, date])
}

model ServiceAudit {
  id String @id @default(cuid())
  actorId String
  actor Member @relation(fields: [actorId], references: [id], onDelete: Restrict)
  entityType String
  entityId String
  action String
  version Int
  reason String?
  createdAt DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}
