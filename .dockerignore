# Deny by default: only source/build inputs may enter the Docker context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!scripts/
scripts/**
!scripts/copy-card-ocr.mjs
!next.config.js
!postcss.config.js
!tailwind.config.ts
!tsconfig.json
!src/
!src/**
!public/
!public/**
!prisma/
prisma/**
!prisma/schema.prisma
!docs/
docs/**
!docs/app-store/
docs/app-store/**
!docs/app-store/METADATA.zh-Hant.json

# Defense in depth for accidental sensitive files inside an allowed directory.
**/.env*
**/.aws
**/.git
**/node_modules
**/private-*
**/*.private.*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.keystore
**/*.jks
**/*.db
**/*.sqlite*
**/*.sql
**/*.log

# Public AWS RDS root CA used by the Ohio review database.
!certificates/
certificates/**
!certificates/aws-rds-us-east-2-root.pem
