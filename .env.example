# 複製成 .env（已加入 .gitignore，不會被提交），並填入你自己的 RDS 密碼。
# 連線字串格式：postgresql://<使用者>:<密碼>@<RDS 端點>:5432/<資料庫名稱>
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@YOUR_RDS_ENDPOINT:5432/lionclub"

# 用來簽署登入 session 的密鑰，跑這行產生一組隨機值：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="GENERATE_YOUR_OWN_RANDOM_VALUE"
