# 複製成 .env（已加入 .gitignore，不會被提交），並填入你自己的 RDS 密碼。
# 連線字串格式：postgresql://<使用者>:<密碼>@<RDS 端點>:5432/<資料庫名稱>
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@YOUR_RDS_ENDPOINT:5432/lionclub"

# 用來簽署登入 session 的密鑰，跑這行產生一組隨機值：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="GENERATE_YOUR_OWN_RANDOM_VALUE"

# 邀請 QR 所使用的公開網站網址；未設定時 API 會採用目前請求的網域。
NEXT_PUBLIC_APP_URL="https://lionclubsmembership.com"

# 會員大頭貼：S3 上傳桶與對外讀取網址（可為 CloudFront 網址）
AWS_REGION="ap-northeast-1"
AVATAR_BUCKET_NAME="lionclub-member-avatars"
AVATAR_PUBLIC_BASE_URL="https://YOUR_CLOUDFRONT_OR_PUBLIC_BUCKET_URL"

# 忘記密碼信件：SES 已驗證寄件人
PASSWORD_RESET_FROM_EMAIL="no-reply@lionclubsmembership.com"

# 中央註冊：未設定ID時，只接受唯一且啟用的 AI臺科大獅子會，不建立新分會。
# ONBOARDING_ORGANIZATION_ID="正式資料庫的 AI臺科大組織ID"
# 註冊一律需要有效共同邀請 QR token；不再接受 PIN 或無邀請公開註冊。
# ONBOARDING_REQUIRE_INVITE / CENTRAL_REQUIRE_INVITE 已退役；false 也不能繞過 QR 驗證。

# Web OAuth/OIDC: OFF by default. Run both 20261020020000 and 20261020030000
# migrations in the approved DB-first rollout before enabling. No phone/Meta login.
FEDERATED_AUTH_ENABLED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Fixed callback: NEXT_PUBLIC_APP_URL + /api/auth/oauth/google/callback
# Apple additionally needs Services ID/domain/return URL under the correct Team.
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_TEAM_ID=""
APPLE_OAUTH_KEY_ID=""
APPLE_OAUTH_PRIVATE_KEY=""
# Whole Apple provider stays disabled until fresh reauth + revocation are verified.
# Do not flip this merely to expose a button; signed auth_time remains required.
APPLE_OAUTH_FRESH_REAUTH_ENABLED="false"
# AES-256-GCM key, exactly 32 random bytes encoded as base64; server-only.
# Keep it in approved secret storage, never Git/chat/client NEXT_PUBLIC_ variables.
OAUTH_TOKEN_ENCRYPTION_KEY=""

# 名冊姓名目錄預設關閉。只有營運者已確認被列者資料的揭露依據、
# 受眾、最小欄位與保留/撤回安排後，才可在 SSR runtime 明確設定版本。
# 觀看者的「本人名冊比對同意」不能代替被列者的揭露授權。
# 啟用後也僅限已確認分會會員查看自己分會與直屬祖先，無整冊下載。
# ROSTER_DIRECTORY_DISCLOSURE_VERSION="2026-10-20"
